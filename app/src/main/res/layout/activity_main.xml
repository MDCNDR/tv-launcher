<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Фон: снимок дня -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- Лёгкое затемнение: читаемость обеспечивают «стеклянные» карточки -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_left" />

    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom" />

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- Подпись к снимку -->
        <TextView
            android:id="@+id/wallpaper_caption"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_gravity="top|start"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:maxWidth="360dp"
            android:shadowColor="#99000000"
            android:shadowRadius="6"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />

        <!-- Верхняя строка: обновление и круглые кнопки, под ними подпись кнопки в фокусе -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:clipChildren="false"
            android:gravity="end"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_update"
                    style="@style/Chip"
                    android:drawableStart="@drawable/ic_update"
                    android:drawablePadding="8dp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/btn_vpn"
                    style="@style/Circle"
                    android:contentDescription="@string/vpn"
                    android:src="@drawable/ic_vpn_off"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/btn_net"
                    style="@style/Circle"
                    android:contentDescription="@string/net_checking"
                    android:src="@drawable/ic_net"
                    android:tint="@color/chip_text" />

                <ImageView
                    android:id="@+id/btn_sleep"
                    style="@style/Circle"
                    android:contentDescription="@string/sleep"
                    android:src="@drawable/ic_sleep"
                    android:tint="@color/chip_text" />

                <ImageView
                    android:id="@+id/btn_clean"
                    style="@style/Circle"
                    android:contentDescription="@string/clean"
                    android:src="@drawable/ic_clean"
                    android:tint="@color/chip_text" />

                <ImageView
                    android:id="@+id/btn_wifi"
                    style="@style/Circle"
                    android:contentDescription="@string/wifi"
                    android:src="@drawable/ic_wifi"
                    android:tint="@color/chip_text" />

                <ImageView
                    android:id="@+id/btn_bluetooth"
                    style="@style/Circle"
                    android:contentDescription="@string/bluetooth"
                    android:src="@drawable/ic_bluetooth"
                    android:tint="@color/chip_text" />

                <ImageView
                    android:id="@+id/btn_settings"
                    style="@style/Circle"
                    android:contentDescription="@string/settings"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/chip_text" />
            </LinearLayout>

            <TextView
                android:id="@+id/top_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#99000000"
                android:shadowRadius="6"
                android:textColor="#F2FFFFFF"
                android:textSize="13sp"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- Слева: дата над крупным временем, как на экране блокировки iOS -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginBottom="56dp"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-medium"
                android:format12Hour="EEEE, d MMMM"
                android:format24Hour="EEEE, d MMMM"
                android:shadowColor="#66000000"
                android:shadowRadius="10"
                android:textColor="#E6FFFFFF"
                android:textSize="24sp" />

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:format12Hour="H:mm"
                android:format24Hour="H:mm"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:shadowColor="#66000000"
                android:shadowRadius="18"
                android:textColor="#FFFFFFFF"
                android:textSize="132sp" />
        </LinearLayout>

        <!-- Справа: виджеты погоды и курсов -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginBottom="56dp"
            android:clipChildren="false"
            android:orientation="horizontal">

            <!-- Погода: ОК — прогноз, долгое ОК — город -->
            <LinearLayout
                android:id="@+id/weather_block"
                android:layout_width="250dp"
                android:layout_height="180dp"
                android:background="@drawable/glass_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/weather_city"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/weather_temp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-light"
                        android:includeFontPadding="false"
                        android:text="—"
                        android:textColor="#FFFFFFFF"
                        android:textSize="52sp" />

                    <ImageView
                        android:id="@+id/weather_icon"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:importantForAccessibility="no"
                        android:visibility="invisible" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/weather_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/weather_loading"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/weather_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Курсы ЦБ -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="180dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/glass_card"
                android:minWidth="180dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/rates_title"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/rates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="7dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Док с приложениями, по центру снизу -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/dock_bg"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="10dp">

            <HorizontalScrollView
                android:id="@+id/fav_scroll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/fav_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
