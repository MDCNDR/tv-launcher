<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Фон: снимок дня -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- Лёгкое затемнение снизу под доком -->
    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom" />

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- Верхняя строка: обновление и круглые кнопки, под ними подпись кнопки в фокусе -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:clipChildren="false"
            android:gravity="end"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_update"
                    style="@style/Chip"
                    android:drawableStart="@drawable/ic_update"
                    android:drawablePadding="8dp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/btn_vpn"
                    style="@style/Circle"
                    android:contentDescription="@string/vpn"
                    android:src="@drawable/ic_vpn_off"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/btn_net"
                    style="@style/Circle"
                    android:contentDescription="@string/net_checking"
                    android:src="@drawable/ic_net"
                    android:tint="@color/chip_text" />

                <ImageView
                    android:id="@+id/btn_sleep"
                    style="@style/Circle"
                    android:contentDescription="@string/sleep"
                    android:src="@drawable/ic_sleep"
                    android:tint="@color/chip_text" />

                <ImageView
                    android:id="@+id/btn_clean"
                    style="@style/Circle"
                    android:contentDescription="@string/clean"
                    android:src="@drawable/ic_clean"
                    android:tint="@color/chip_text" />

                <ImageView
                    android:id="@+id/btn_store"
                    style="@style/Circle"
                    android:contentDescription="@string/store"
                    android:src="@drawable/ic_store"
                    android:tint="@color/chip_text" />

                <ImageView
                    android:id="@+id/btn_wifi"
                    style="@style/Circle"
                    android:contentDescription="@string/wifi"
                    android:src="@drawable/ic_wifi"
                    android:tint="@color/chip_text" />

                <ImageView
                    android:id="@+id/btn_bluetooth"
                    style="@style/Circle"
                    android:contentDescription="@string/bluetooth"
                    android:src="@drawable/ic_bluetooth"
                    android:tint="@color/chip_text" />

                <ImageView
                    android:id="@+id/btn_settings"
                    style="@style/Circle"
                    android:contentDescription="@string/settings"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/chip_text" />
            </LinearLayout>

            <TextView
                android:id="@+id/top_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#99000000"
                android:shadowRadius="6"
                android:textColor="#F2FFFFFF"
                android:textSize="13sp"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- По центру: дата, крупное время и погода под ними -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="40dp"
            android:clipChildren="false"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:format12Hour="EEEE, d MMMM"
                android:format24Hour="EEEE, d MMMM"
                android:shadowColor="#66000000"
                android:shadowRadius="10"
                android:textColor="#E6FFFFFF"
                android:textSize="24sp" />

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:format12Hour="H:mm"
                android:format24Hour="H:mm"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:shadowColor="#66000000"
                android:shadowRadius="18"
                android:textColor="#FFFFFFFF"
                android:textSize="140sp" />

            <!-- Погода: ОК — прогноз, долгое ОК — город -->
            <LinearLayout
                android:id="@+id/weather_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/glass_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="26dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:id="@+id/weather_icon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/weather_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:text="—"
                    android:textColor="#FFFFFFFF"
                    android:textSize="36sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/weather_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="@string/weather_loading"
                            android:textColor="#FFFFFFFF"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/weather_city"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:maxLines="1"
                            android:textColor="#B3FFFFFF"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/weather_details"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Док с приложениями, по центру снизу -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/dock_bg"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="10dp">

            <HorizontalScrollView
                android:id="@+id/fav_scroll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/fav_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
