<?xml version="1.0" encoding="utf-8"?>
<!-- «Стекло» в стиле iOS: тёмный полупрозрачный материал и тонкая светлая кромка -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#59FFFFFF" />
            <stroke android:width="1.5dp" android:color="#B3FFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#5C1C1C1E" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</selector>
