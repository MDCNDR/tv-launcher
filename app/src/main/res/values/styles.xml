<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#0B0C10</color>
    <color name="chip_fill">#59000000</color>
    <color name="text_primary">#F2F2F2</color>
    <color name="text_secondary">#99EBEBF5</color>
    <color name="ios_blue">#FF0A84FF</color>
    <color name="ios_green">#FF30D158</color>
    <color name="ios_yellow">#FFFFD60A</color>
    <color name="ios_red">#FFFF453A</color>

    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Круглая кнопка с иконкой в верхней строке -->
    <style name="Circle">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/circle_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- Диалоги: тёмное «стекло» со скруглением, как в iOS -->
    <style name="Dialog" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorAccent">#FF0A84FF</item>
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:textColorSecondary">#B3EBEBF5</item>
    </style>
</resources>
